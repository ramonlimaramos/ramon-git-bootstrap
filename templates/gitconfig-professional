[user]
    name = Ramon Ramos
    email = ramon.ramos@podium.com

[core]
    sshCommand = ssh -i ~/.ssh/id_ed25519_github_enterprise -o IdentitiesOnly=yes -F /dev/null -o HostName=ssh.github.com -p 443

[format]
    signoff = true

# Same reason as the personal scope: HTTPS remotes are rewritten to SSH so the
# key pinned above decides the identity, not the active GitHub CLI account.
[url "git@github.com:"]
    insteadOf = https://github.com/
